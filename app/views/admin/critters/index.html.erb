<%= render partial: "admin/critters/card", collection: @critters.select { |c| c.type == "Insect" }, as: :critter %>

<h2>
  <%= link_to "Sea Creatures", admin_sea_creatures_path %>
</h2>
<%= render partial: "admin/critters/card", collection: @critters.select { |c| c.type == "SeaCreature" }, as: :critter %>

