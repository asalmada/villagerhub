<div>
  <%= form.label :name %>
  <%= form.text_field :name %>
</div>

<div>
  <%= form.label :entry_id, "Entry ID" %>
  <%= form.text_field :entry_id %>
</div>

<div>
  <%= form.label :sell_price, "Sell price" %>
  <%= form.number_field :sell_price, step: 1, min: 0 %>
</div>

<div>
  <%= form.label :icon_image, "Icon image" %>
  <%= form.file_field :icon_image %>
</div>

<div>
  <%= form.label :critterpedia_image, "Critterpedia image" %>
  <%= form.file_field :critterpedia_image %>
</div>

<div>
  <%= form.label :furniture_image, "Furniture image" %>
  <%= form.file_field :furniture_image %>
</div>

<div>
  <%= form.label :furniture_size, "Furniture size" %>
  <%= form.select :furniture_size,
        options_for_select(
          if form.object.is_a?(Insect)
            [["1x1", "one_by_one"]]
          else
            Critter.furniture_sizes.map { |k,v| [v,k] }
          end,
          form.object.furniture_size
        ) %>
</div>

<div>
  <%= form.label :furniture_has_surface, "Does furniture have a surface?" %>
  <%= form.check_box :furniture_has_surface %>
</div>

<div>
  <%= form.label :description, "Description" %>
  <%= form.text_area :description %>
</div>

<div>
  <%= form.label :catch_phrase, "Catch phrase" %>
  <%= form.text_field :catch_phrase %>
</div>

<div>
  <%= form.label :catches_to_unlock, "Catches to unlock" %>
  <%= form.number_field :catches_to_unlock, step: 1, min: 0 %>
</div>

<div>
  <%= form.fields_for :availabilities do |a| %>
    <div class="availability">
      <%= a.label :month %>
      <%= a.number_field :month, min: 1, max: 12 %>

      <%= a.label :hemisphere %>
      <%= a.select :hemisphere, CritterAvailability.hemispheres.map { |k,v| [v,k] } %>

      <%= a.label :all_day %>
      <%= a.check_box :all_day %>

      <%= a.label :start_minute %>
      <%= a.number_field :start_minute, step: 1, min: 0, max: 1439 %>

      <%= a.label :end_minute %>
      <%= a.number_field :end_minute, step: 1, min: 0, max: 1439 %>

      <%= a.check_box :_destroy %>
      <%= a.label :_destroy, "Remove this availability" %>
    </div>
  <% end %>
<div>