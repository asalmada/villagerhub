<div class="critter-details">
  <h1><%= critter.name %></h1>

  <p><strong>Entry ID</strong> <%= critter.entry_id %></p>
  <div>
    <%= image_tag critter.icon_image if critter.icon_image.attached? %>
  </div>
  <div>
    <%= image_tag critter.critterpedia_image if critter.critterpedia_image.attached?  %>
  </div>
  <div>
    <%= image_tag critter.furniture_image if critter.furniture_image.attached? %>
  </div>
  <p><strong>Sell price</strong> <%= critter.sell_price %> bells</p>
  <p><strong>Furniture size</strong> <%= critter.furniture_size %></p>
  <p><strong>Furniture has size</strong> <%= critter.furniture_has_surface %></p>
  <p><strong>Description</strong> <%= critter.description %></p>
  <p><strong>Catch_phrase</strong> <%= critter.catch_phrase %></p>
  <p><strong>Catches to unlock</strong> <%= critter.catches_to_unlock %></p>

  <!-- Specific attributes for certain critter types -->
  <% if critter.spawn_location.present? %>
    <p><strong>Spawn location</strong> <%= critter.spawn_location %></p>
  <% end %>
  <% if critter.shadow_size.present? %>
    <p><strong>Shadow size</strong> <%= critter.shadow_size %></p>
  <% end %>
  <% if critter.visual_width.present? %>
    <p><strong>Visual width</strong> <%= critter.visual_width %></p>
  <% end %>
  <% if critter.catch_difficulty.present? %>
    <p><strong>Catch difficulty</strong> <%= critter.catch_difficulty %></p>
  <% end %>
  <% if critter.spawn_weather.present? %>
    <p><strong>Spawn weather</strong> <%= critter.spawn_weather %></p>
  <% end %>
  <% if critter.movement_speed.present? %>
    <p><strong>Movement speed</strong> <%= critter.movement_speed %></p>
  <% end %>

  <% if critter.availabilities.present? %>
    <h3>Availability</h3>
    <ul>
      <% critter.availabilities.each do |a| %>
        <li>
          <%= a.month %> - <%= a.hemisphere.capitalize %>
          <% unless a.all_day? %>
            (<%= a.start_minute %> → <%= a.end_minute %>)
          <% else %>
            (All day)
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= link_to "Back", back_path %>
</div>